{
  "name": "@helix/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint src --max-warnings=0",
    "preview": "vite preview --host 0.0.0.0",
    "audit:a11y": "node scripts/accessibility-audit.mjs",
    "audit:a11y:fallback": "node scripts/accessibility-audit.mjs --fallback-ok",
    "test": "vitest run --config vitest.config.ts --passWithNoTests --exclude='tests/e2e/**' --exclude='dist/**'",
    "test:e2e": "playwright test",
    "lint:e2e": "eslint tests/e2e --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tests/e2e/tsconfig.json",
    "test:e2e:meet-live": "playwright test --config playwright.meet-live.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@helix/contracts": "workspace:*",
    "@helix/sdk-types": "workspace:*",
    "@helix/sdk-web": "workspace:*",
    "@tanstack/pacer": "0.22.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-pacer": "0.23.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.10",
    "@tanstack/store": "0.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.41.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4",
    "@better-auth/passkey": "1.7.3",
    "@better-auth/utils": "0.5.0",
    "better-auth": "1.7.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@helix/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.36",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router-devtools": "1.167.1"
  }
}
