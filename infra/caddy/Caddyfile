{
	admin off
	servers {
		protocols h1 h2 h3
		max_header_size 32KB
		keepalive_interval 30s
		timeouts {
			read_header 10s
			read_body 2m
			idle 2m
		}
	}
}

{$HELIX_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), fullscreen=(self), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-src 'self' {$HELIX_JITSI_ORIGIN:https://meet.localhost}"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Cross-Origin-Resource-Policy "same-origin"
		Origin-Agent-Cluster "?1"
	}

	@content_upload {
		method PUT
		path /v1/dav/files/*
	}
	@bulk_body {
		method POST
		path /v1/api/tools/drive.finalize /v1/api/tools/docs.import-docx /v1/api/tools/sheets.import-csv /v1/api/tools/sheets.import-tsv /v1/api/tools/sheets.import-xlsx /v1/api/tools/sheets.import-ods /v1/api/tools/slides.import-pptx /v1/api/tools/mail.send
	}
	@standard_body {
		not {
			method PUT
			path /v1/dav/files/*
		}
		not {
			method POST
			path /v1/api/tools/drive.finalize /v1/api/tools/docs.import-docx /v1/api/tools/sheets.import-csv /v1/api/tools/sheets.import-tsv /v1/api/tools/sheets.import-xlsx /v1/api/tools/sheets.import-ods /v1/api/tools/slides.import-pptx /v1/api/tools/mail.send
		}
	}
	request_body @standard_body {
		max_size 2MB
	}
	request_body @bulk_body {
		max_size 32MB
	}
	request_body @content_upload {
		max_size 64MB
	}

	# Caddy streams bodies by default. Keep its buffering knobs unset so slow
	# upstreams apply TCP backpressure instead of allocating whole bodies.
	reverse_proxy {$HELIX_UPSTREAM:host.docker.internal:3000} {
		header_up -X-Helix-Mfa-Verified
		stream_timeout 24h
		stream_close_delay 5m
		transport http {
			dial_timeout 5s
			response_header_timeout 2m
			read_timeout 5m
			write_timeout 2m
			max_response_header 64KB
			max_conns_per_host 2048
		}
	}
}
