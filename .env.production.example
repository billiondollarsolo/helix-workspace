# Non-secret inputs for docker-compose.production.yml.
# Copy to a protected operator-only env file. Secret values belong in the
# mounted files documented in docs/deployment-production.md, not here.

HELIX_DOMAIN=workspace.example.com

# HTTPS certificate source for HELIX_DOMAIN. Leave empty for automatic
# Let's Encrypt certificates, or set your email so the certificate authority can
# warn you about renewal problems (recommended). `internal` uses Caddy's local
# CA (testing only). To bring your own certificate, see "TLS certificates" in
# docs/deployment-production.md.
HELIX_CADDY_TLS=
HELIX_SMTP_RECEIVE_PORT=25

# A label for where this deployment's data lives (lowercase letters, digits and
# hyphens, for example eu-central or us-east). Choose it before the first
# start: the workspace is created in this region and Helix refuses to run it
# under another one.
HELIX_REGION=eu-central

# The workspace's name, shown in invitations and the sign-in page.
HELIX_DEFAULT_ORG_NAME=Example Workspace

# Exact promoted registry references. Replace every placeholder with the
# corresponding main-branch image digest produced by the reviewed CI run.
# Tags alone are intentionally rejected by the release process.
HELIX_IMAGE=ghcr.io/billiondollarsolo/helix-workspace@sha256:REPLACE_WITH_64_HEX
HELIX_WEB_IMAGE=ghcr.io/billiondollarsolo/helix-workspace-web@sha256:REPLACE_WITH_64_HEX
HELIX_POSTGRES_IMAGE=ghcr.io/billiondollarsolo/helix-workspace-postgres@sha256:REPLACE_WITH_64_HEX
HELIX_NATS_IMAGE=ghcr.io/billiondollarsolo/helix-workspace-nats@sha256:REPLACE_WITH_64_HEX
HELIX_MEILISEARCH_IMAGE=ghcr.io/billiondollarsolo/helix-workspace-meilisearch@sha256:REPLACE_WITH_64_HEX
HELIX_CERBOS_IMAGE=ghcr.io/billiondollarsolo/helix-workspace-cerbos@sha256:REPLACE_WITH_64_HEX
HELIX_SPAMD_IMAGE=ghcr.io/billiondollarsolo/helix-workspace-spamassassin@sha256:REPLACE_WITH_64_HEX
HELIX_CLAMAV_IMAGE=ghcr.io/billiondollarsolo/helix-workspace-clamav@sha256:REPLACE_WITH_64_HEX

# Administrators pass the MFA gate by signing in with an authenticator app or
# passkey. Set these only when an upstream authenticator signs the actor-bound
# MFA assertion described in docs/deployment-production.md.
# HELIX_MFA_ASSERTION_ISSUER=https://auth.example.com
# HELIX_MFA_ASSERTION_AUDIENCE=helix-workspace

# Approved values: ses, postmark, mailgun, managed-smtp, smtp-relay.
MAIL_PROVIDER=postmark
MAIL_FROM_DOMAIN=example.com
MAIL_SMTP_HOST=smtp.postmarkapp.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=provider-user-id
MAIL_SMTP_SECURE=false

# Set these to true only after collecting the evidence described in the
# production deployment guide. They are attestations, not feature toggles.
HELIX_POSTGRES_ENCRYPTION_AT_REST_ATTESTED=true
HELIX_OBJECT_STORAGE_ENCRYPTION_AT_REST_ATTESTED=true
HELIX_BACKUP_ENCRYPTION_AT_REST_ATTESTED=true

# Object storage. The bundled RustFS needs no settings here: it is served over
# TLS, encrypts with its local KMS key, and keeps deleted versions for the
# retention below. To use an external S3 service instead, set RUSTFS_ENDPOINT,
# RUSTFS_REGION, RUSTFS_SSE_KMS_KEY_ID and an empty RUSTFS_PUBLIC_ENDPOINT.
RUSTFS_OBJECT_LOCK_MODE=GOVERNANCE
RUSTFS_OBJECT_LOCK_RETENTION_DAYS=30

# Backup/restore operators must inject HELIX_BACKUP_MANIFEST_HMAC_KEY from a
# separate protected secret store. Only its non-secret reference belongs here.
HELIX_BACKUP_MANIFEST_HMAC_KEY_REF=vault://production/helix-backup-manifest-hmac

# Explicit Drive scan ceiling for the pilot's supported 1 GiB upload size.
DRIVE_CLAMAV_MAX_BYTES=1073741824
DRIVE_CLAMAV_SCANNER_VERSION=clamd

# Optional bundled SearXNG: start with --profile web-search after creating
# $HELIX_PRODUCTION_SECRETS_DIR/searxng_secret (at least 32 random characters).
# No search port is published; connect http://searxng:8080 in Admin → AI retrieval.
# Starting the service does not enable Assistant Web search automatically.
# Set true only when using the explicitly configured private AI/search endpoint.
# Public-page fetching still rejects private destinations.
HELIX_AI_ALLOW_PRIVATE_NETWORK=false

# Optional password manager (Vaultwarden) on its own hostname. Not installed
# unless both lines are set; then turn it on for people in Admin → Apps →
# Passwords. See "Optional installs" in docs/deployment-production.md.
# COMPOSE_PROFILES=passwords
# HELIX_PASSWORDS_DOMAIN=vault.example.com

# Optional Meet and Calendar (video meetings on a bundled LiveKit). Not installed
# unless every Compose command also passes -f docker-compose.meet.yml; then
# these two are required. Meet signals through this Workspace's own address;
# turn. must be DNS only. See "Optional installs" in docs/deployment-production.md.
# HELIX_MEET_TURN_DOMAIN=turn.example.com
# HELIX_MEET_PUBLIC_IP=203.0.113.10
