#!/usr/bin/with-contenv sh
# shellcheck shell=sh
set -eu

secret=$(cat /run/secrets/jitsi_turn_shared_secret)
[ "${#secret}" -ge 32 ] || {
  echo "TURN shared secret must contain at least 32 characters" >&2
  exit 1
}

# s6 imports this file for the stock 10-config process. The secret therefore
# never appears in Compose, the image command, or the repository.
printf '%s' "$secret" > /var/run/s6/container_environment/TURN_CREDENTIALS
