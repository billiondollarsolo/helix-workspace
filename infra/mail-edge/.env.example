HELIX_MAIL_EDGE_HOSTNAME=mx1.example.com
HELIX_MAIL_RELAY_DOMAINS=example.com,example.org
HELIX_MAIL_INGEST_HOST=helix
HELIX_MAIL_INGEST_PORT=2525
HELIX_MAIL_EDGE_BIND=0.0.0.0
HELIX_MAIL_EDGE_PORT=25
HELIX_MAIL_MAX_MESSAGE_BYTES=52428800
HELIX_MAIL_POSTMASTER=postmaster@example.com
HELIX_MAIL_TLS_CERT=/etc/helix-mail/tls.crt
HELIX_MAIL_TLS_KEY=/etc/helix-mail/tls.key
HELIX_BACKEND_NETWORK=helix-production-backend
