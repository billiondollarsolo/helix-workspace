{
  "name": "helix-workspace",
  "license": "Apache-2.0",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.0 <25.0.0",
    "pnpm": ">=11.18.0 <12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "LC_ALL=C LANG=C bash infra/scripts/dev-local.sh",
    "helix": "pnpm --filter @helix/app",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:single-tenant": "HELIX_MODE=single-tenant turbo run test",
    "test:multi-tenant-saas": "HELIX_MODE=multi-tenant-saas turbo run test",
    "test:cross-tenant-isolation": "HELIX_MODE=multi-tenant-saas DATABASE_URL=\"${DATABASE_URL:-postgres://helix:helix_dev_password@127.0.0.1:28432/helix}\" pnpm --filter @helix/app exec vitest run src/platform/tenancy/cross-tenant-isolation.test.ts",
    "typecheck": "turbo run typecheck",
    "quality:a11y": "pnpm --filter @helix/web audit:a11y",
    "quality:a11y:fallback": "pnpm --filter @helix/web audit:a11y:fallback",
    "quality:k6": "infra/scripts/validate-k6.sh",
    "quality:k6:target": "infra/scripts/validate-k6.sh --no-mock",
    "quality:live-auth-smoke": "infra/scripts/live-auth-smoke.sh",
    "quality:live-demo-data": "bash infra/scripts/live-demo-data-smoke.sh",
    "quality:boundaries": "node infra/scripts/verify-workspace-boundaries.mjs",
    "quality:live-restore-drill": "bash infra/scripts/live-restore-drill-smoke.sh",
    "quality:mail-deliverability-smoke": "node --test infra/scripts/mail-deliverability-evidence.test.mjs && node infra/scripts/mail-deliverability-smoke.mjs",
    "quality:mail-live-evidence": "node infra/scripts/mail-live-evidence-smoke.mjs",
    "quality:chat-live-evidence": "node infra/scripts/chat-live-evidence-smoke.mjs",
    "quality:agent-live-evidence": "node infra/scripts/agent-live-evidence-smoke.mjs",
    "quality:dast-evidence": "node infra/scripts/dast-evidence.mjs",
    "quality:dast-contract:test": "vitest run infra/scripts/dast-evidence.test.mjs",
    "quality:release-readiness-manifest": "node infra/scripts/release-readiness-manifest.mjs",
    "quality:release-evidence-contract:test": "vitest run infra/scripts/release-evidence-binding.test.mjs infra/scripts/release-evidence-binding.integration.test.mjs infra/scripts/release-readiness-manifest.test.mjs infra/scripts/dast-evidence.test.mjs infra/scripts/mail-live-evidence-smoke.test.mjs infra/scripts/agent-live-evidence-smoke.test.mjs infra/scripts/chat-live-evidence-smoke.test.mjs infra/scripts/data-plane-live-evidence.test.mjs infra/scripts/restore-drill-evidence.test.mjs infra/scripts/failure-recovery-runner.test.mjs && node --test infra/scripts/drive-live-evidence-smoke.test.mjs",
    "quality:production-images": "node infra/scripts/validate-production-images.mjs",
    "quality:production-dependency-audit": "node infra/scripts/production-dependency-audit.mjs",
    "quality:negative-security-matrix": "node infra/scripts/negative-security-matrix.mjs",
    "quality:local-disconnected-live-smokes": "node scripts/local-disconnected-live-smokes.mjs",
    "quality:local-disconnected-live-smokes:test": "vitest run scripts/local-disconnected-live-smokes.test.mjs",
    "helix:drive-sync": "node scripts/helix-drive-sync-setup.mjs",
    "quality:production-readiness-contract:test": "node infra/scripts/negative-security-matrix.mjs > /dev/null && vitest run infra/scripts/production-compose.test.mjs infra/scripts/production-image-workflow.test.mjs infra/scripts/production-dependency-images.test.mjs infra/scripts/supply-chain-workflow.test.mjs infra/scripts/production-dependency-audit.test.mjs infra/scripts/negative-security-matrix.test.mjs infra/scripts/backup-manifest.test.mjs infra/scripts/production-readiness-workflow.test.mjs infra/scripts/normalize-image-spdx.test.mjs infra/scripts/release-workflow.test.mjs",
    "quality:gates-contract:test": "vitest run infra/scripts/quality-gates-contract.test.mjs && node infra/scripts/verify-source-structure.mjs --self-test",
    "quality:launch-docs": "node infra/scripts/verify-launch-docs.mjs",
    "quality:launch-docs:test": "vitest run infra/scripts/verify-launch-docs.test.mjs",
    "infra:build": "docker compose build",
    "infra:config": "docker compose config",
    "infra:config:observability": "docker compose --profile observability config",
    "infra:up": "docker compose up -d --build",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:caddy:validate": "bash infra/scripts/validate-caddy-hardening.sh",
    "infra:helm:validate": "bash infra/scripts/validate-helm.sh",
    "infra:meet:validate": "bash infra/scripts/validate-meet-jitsi.sh",
    "infra:demo:live-smoke": "bash infra/scripts/live-demo-data-smoke.sh",
    "infra:restore:validate": "bash infra/scripts/validate-restore-drill.sh",
    "infra:restore:live-smoke": "bash infra/scripts/live-restore-drill-smoke.sh",
    "cerbos:compile": "docker run --rm -v \"$PWD/infra/cerbos/policies:/policies:ro\" ghcr.io/cerbos/cerbos:0.55.0@sha256:4b9d3b58c4f11c1b8953bc798d8d086e64f276882253ab169625fddc7f432515 compile /policies",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "corpus:fetch": "tsx test-corpus/fetch.ts",
    "corpus:fetch:force": "tsx test-corpus/fetch.ts --force",
    "corpus:seed": "tsx test-corpus/seed.ts",
    "audit:prod": "node infra/scripts/audit-production-dependencies.mjs",
    "quality:meet-live-media": "pnpm --filter @helix/web test:e2e:meet-live",
    "quality:operational-metrics": "pnpm --filter @helix/app exec vitest run src/api/metrics.test.ts src/platform/observability/assets.test.ts src/platform/mail/outbound.test.ts src/platform/chat/realtime.test.ts && pnpm --filter @helix/app exec vitest run src/platform/drive/store-metering.test.ts -t 'emits positive storage.delta after a prepared upload is finalized'",
    "quality:observability-production": "pnpm --filter @helix/app exec vitest run src/platform/observability/config.test.ts src/platform/observability/assets.test.ts",
    "quality:product-slos": "node infra/scripts/product-slo-report.mjs --static && node --test infra/scripts/product-slo-report.test.mjs",
    "quality:supply-chain": "node infra/scripts/verify-supply-chain-policy.mjs --self-test && node infra/scripts/audit-production-dependencies.mjs --self-test && node infra/scripts/audit-production-dependencies.mjs && pnpm quality:dependencies && node infra/scripts/verify-deployable-artifacts.mjs",
    "quality:artifacts": "node infra/scripts/verify-deployable-artifacts.mjs",
    "security:scan-history": "node infra/scripts/scan-git-history-secrets.mjs",
    "security:protect-main": "node infra/scripts/apply-branch-protection.mjs",
    "quality:contracts": "node infra/scripts/verify-unsafe-cast-budget.mjs",
    "quality:dependencies": "knip --no-progress && node infra/scripts/verify-dependency-policy.mjs && pnpm dedupe --check",
    "infra:compose:validate": "node infra/scripts/validate-compose-local-only.mjs",
    "infra:mail-edge:validate": "node infra/scripts/validate-mail-edge.mjs",
    "infra:mail-edge:smoke": "node infra/scripts/mail-edge-smoke.mjs",
    "quality:environment": "tsx infra/scripts/generate-environment-reference.ts",
    "quality:environment:write": "tsx infra/scripts/generate-environment-reference.ts --write",
    "quality:duplicates": "node infra/scripts/verify-source-structure.mjs",
    "quality:file-size": "node infra/scripts/verify-source-structure.mjs --size"
  },
  "devDependencies": {
    "@helix/config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "turbo": "2.10.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "knip": "6.34.0",
    "@vitest/coverage-v8": "4.1.11"
  },
  "dependencies": {}
}
