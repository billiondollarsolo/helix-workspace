{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meet Jitsi plugin config",
  "type": "object",
  "required": ["jitsiDomain", "publicUrl", "jwt"],
  "properties": {
    "jitsiDomain": {
      "type": "string",
      "description": "DNS name for the Jitsi web entrypoint, normally meet.<domain>."
    },
    "publicUrl": {
      "type": "string",
      "format": "uri",
      "description": "Browser-facing Jitsi URL used in iframe launch metadata."
    },
    "jwt": {
      "type": "object",
      "required": ["appId", "issuer", "audience", "secretEnv"],
      "properties": {
        "appId": { "type": "string", "default": "helix-meet" },
        "issuer": { "type": "string", "default": "helix" },
        "audience": { "type": "string", "default": "jitsi" },
        "secretEnv": { "type": "string", "default": "MEET_JITSI_JWT_SECRET" },
        "ttlSeconds": { "type": "integer", "minimum": 60, "default": 3600 }
      },
      "additionalProperties": false
    },
    "webhook": {
      "type": "object",
      "properties": {
        "sharedSecretEnv": { "type": "string", "default": "MEET_JITSI_WEBHOOK_SHARED_SECRET" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
