{
  "name": "@helix/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint src --max-warnings=0",
    "preview": "vite preview --host 0.0.0.0",
    "audit:a11y": "node scripts/accessibility-audit.mjs",
    "audit:a11y:fallback": "node scripts/accessibility-audit.mjs --fallback-ok",
    "test": "vitest run --config vitest.config.ts --passWithNoTests --exclude='tests/e2e/**'",
    "test:e2e": "playwright test",
    "lint:e2e": "eslint tests/e2e --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tests/e2e/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@helix/sdk-web": "workspace:*",
    "@tanstack/react-form": "^1.32.0",
    "@tanstack/react-pacer": "0.22.1",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tanstack/store": "latest",
    "@tiptap/extension-collaboration": "^3.23.5",
    "@tiptap/extension-collaboration-caret": "^3.23.5",
    "@tiptap/react": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "latest",
    "lib0": "^0.2.114",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.7.0",
    "sonner": "latest",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@helix/config": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-plugin": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.11.4",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  }
