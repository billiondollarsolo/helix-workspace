{
  "name": "@helix/sdk",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@helix/sdk-types": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db-tenant-scoped": {
      "types": "./dist/db-tenant-scoped.d.ts",
      "default": "./dist/db-tenant-scoped.js"
    },
    "./feature-flags": {
      "types": "./dist/feature-flags.d.ts",
      "default": "./dist/feature-flags.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./metering": {
      "types": "./dist/metering.d.ts",
      "default": "./dist/metering.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests --exclude='dist/**'",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
