  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reindex:search": "tsx src/db/reindex-search.ts",
    "db:backfill:mail-receiving-domain": "tsx src/db/backfill-mail-receiving-domain.ts",
    "db:seed:demo": "tsx src/db/demo-seed/cli.ts",
    "db:seed:oauth": "tsx src/db/seed-local-oauth.ts",
    "db:seed:smoke-agent": "tsx src/db/seed-live-smoke-oauth.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests --exclude='dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1148.0",
