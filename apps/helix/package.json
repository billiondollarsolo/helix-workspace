{
  "name": "@helix/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:index:demo-search": "tsx src/db/index-local-demo-search.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:prepare:demo": "tsx src/db/prepare-local-demo.ts",
    "db:reindex:search": "tsx src/db/reindex-search.ts",
    "db:seed:demo": "tsx src/db/seed-local-demo.ts",
    "db:seed:oauth": "tsx src/db/seed-local-oauth.ts",
    "db:seed:smoke-agent": "tsx src/db/seed-live-smoke-oauth.ts",
    "db:verify:demo": "tsx src/db/verify-local-demo.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/utils": "^0.4.0",
    "@fastify/cookie": "latest",
    "@fastify/cors": "latest",
    "@fastify/swagger": "latest",
    "@fastify/swagger-ui": "latest",
    "@fastify/websocket": "latest",
    "@helix/sdk": "workspace:*",
    "@helix/sdk-types": "workspace:*",
    "@nats-io/transport-node": "^3.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "latest",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "latest",
    "@opentelemetry/sdk-node": "latest",
    "@trpc/server": "^11.0.0",
    "better-auth": "^1.6.11",
    "drizzle-orm": "latest",
    "fastify": "latest",
    "ioredis": "^5.10.1",
    "lib0": "^0.2.114",
    "liquidjs": "^10.21.0",
    "mailauth": "^4.13.3",
    "mailparser": "^3.9.8",
    "nanoid": "latest",
    "nodemailer": "^8.0.7",
    "pg": "^8.21.0",
    "pino": "^9.0.0",
    "postgres": "latest",
    "prom-client": "latest",
    "smtp-server": "^3.18.4",
    "y-protocols": "^1.0.6",
    "yaml": "^2.9.0",
    "yjs": "^13.6.27",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/smtp-server": "^3.5.13",
    "drizzle-kit": "latest",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
