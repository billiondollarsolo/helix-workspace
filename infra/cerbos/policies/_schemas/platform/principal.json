{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cerbos:///platform/principal.json",
  "type": "object",
  "required": ["org_id", "type"],
  "additionalProperties": true,
  "properties": {
    "org_id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["user", "agent", "service_account", "system"]
    },
    "parent_user_id": { "type": "string", "minLength": 1 },
    "scopes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
