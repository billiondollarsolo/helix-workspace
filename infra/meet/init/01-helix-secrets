#!/usr/bin/with-contenv sh
# shellcheck shell=sh
set -eu

# The production Meet install mounts each credential as a file named after the
# environment variable the stock image reads. s6 imports every file in its
# container environment directory, so a credential never appears in Compose,
# the image command, or the repository.
for file in /run/helix-jitsi-env/*; do
  [ -f "$file" ] || continue
  value=$(cat "$file")
  [ "${#value}" -ge 32 ] || {
    echo "$(basename "$file") must contain at least 32 characters" >&2
    exit 1
  }
  printf '%s' "$value" > "/var/run/s6/container_environment/$(basename "$file")"
done
