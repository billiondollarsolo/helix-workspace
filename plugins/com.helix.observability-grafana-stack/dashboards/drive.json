{
  "uid": "helix-drive",
  "title": "Helix Drive",
  "tags": ["helix", "drive"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Upload throughput",
      "datasource": { "type": "prometheus", "uid": "helix-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(helix_drive_upload_bytes_total[5m]))" }],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Preview generation latency",
      "datasource": { "type": "prometheus", "uid": "helix-prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(helix_drive_preview_duration_seconds_bucket[5m])) by (le))" }],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    }
  ]
}
