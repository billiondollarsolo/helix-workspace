{
  "name": "@helix/sdk-types",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editors": {
      "types": "./dist/editors.d.ts",
      "default": "./dist/editors.js"
    },
    "./metering": {
      "types": "./dist/metering.d.ts",
      "default": "./dist/metering.js"
    },
    "./tenant-config": {
      "types": "./dist/tenant-config.d.ts",
      "default": "./dist/tenant-config.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@helix/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
