# Optional Meet install: LiveKit signalling on the Workspace address, imported
# inside the Workspace site. Media does not pass through here; it goes straight
# to LiveKit's published media and TURN ports.
@livekit path /rtc /rtc/*
handle @livekit {
	reverse_proxy {$HELIX_LIVEKIT_UPSTREAM:livekit:7880} {
		header_up -X-Helix-Mfa-Verified
		# Websocket signalling: pass every frame on at once.
		flush_interval -1
	}
}
