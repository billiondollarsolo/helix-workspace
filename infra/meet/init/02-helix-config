#!/usr/bin/with-contenv sh
# shellcheck shell=sh
set -eu

# The stock images take ownership of everything under /config when they start,
# which fails on a read-only mount. Checked-in overrides are therefore mounted
# here and copied into place before the stock configuration step runs.
for file in /run/helix-jitsi-config/*; do
  [ -f "$file" ] || continue
  cp "$file" "/config/$(basename "$file")"
done
