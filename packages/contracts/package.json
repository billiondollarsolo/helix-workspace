{
  "name": "@helix/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./tenant-config": {
      "types": "./dist/tenant-config.d.ts",
      "default": "./dist/tenant-config.js"
    },
    "./drive": {
      "types": "./dist/drive.d.ts",
      "default": "./dist/drive.js"
    },
    "./mail": {
      "types": "./dist/mail.d.ts",
      "default": "./dist/mail.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "default": "./dist/chat.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --exclude='dist/**'",
    "lint": "eslint src vitest.config.mjs"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@helix/config": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
