{
  "id": "com.helix.core-asyncapi",
  "name": "Helix AsyncAPI",
  "version": "1.0.0",
  "description": "Generates AsyncAPI documentation from registered Helix event schemas.",
  "vendor": { "name": "Helix" },
  "license": "Apache-2.0",
  "sdkVersion": "^1.0.0",
  "kind": "in-process",
  "main": "index.js",
  "capabilities": {
    "provides": ["asyncapi.document", "rest-endpoints:/asyncapi.json"],
    "consumes": ["events.schema-registry"]
  },
  "permissions": {
    "scopes": ["platform.read"],
    "outbound-network": [],
    "filesystem": [],
    "envVars": []
  }
}
