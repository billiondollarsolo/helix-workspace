{
	admin off
	servers {
		protocols h1 h2 h3
	}
}

{$HELIX_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self \"{$HELIX_JITSI_ORIGIN:https://meet.localhost}\"), microphone=(self \"{$HELIX_JITSI_ORIGIN:https://meet.localhost}\"), display-capture=(self \"{$HELIX_JITSI_ORIGIN:https://meet.localhost}\"), fullscreen=(self \"{$HELIX_JITSI_ORIGIN:https://meet.localhost}\"), geolocation=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-d9Fw2pof/F1+tB54KWGfO8GDBtJxf9LFM1BMcuIYV/M=' {$HELIX_JITSI_ORIGIN:https://meet.localhost}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' wss:; worker-src 'self' blob:; frame-src 'self' {$HELIX_JITSI_ORIGIN:https://meet.localhost}"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Cross-Origin-Resource-Policy "same-origin"
		Origin-Agent-Cluster "?1"
		-Server
	}

	@health path /healthz /readyz
	handle @health {
		reverse_proxy {$HELIX_UPSTREAM} {
			header_up -X-Helix-Mfa-Verified
		}
	}

	@backend {
		path /api/* /oauth /oauth/* /trpc /trpc/* /mcp /mcp/* /v1 /v1/*
		path /openapi.json /openapi.yaml /asyncapi.json
		path /events /events/* /ws /ws/* /sync /sync/* /dav /dav/* /.well-known/*
	}
	handle @backend {
		reverse_proxy {$HELIX_UPSTREAM} {
			header_up -X-Helix-Mfa-Verified
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
