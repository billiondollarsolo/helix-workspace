{
  "name": "@helix/cli",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "bin": {
    "helix": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests --exclude='dist/**'",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@helix/config": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
