# Each regional shard keeps one bridge of headroom for a bridge, node, or zone loss.
SHARD_COUNT=3
REGIONS=us-east-1,us-east-2,us-west-2
JVB_MIN_REPLICAS=3
JVB_MAX_REPLICAS=9
JVB_MAX_PARTICIPANTS=80
JVB_PLANNED_PARTICIPANTS=160
JVB_CPU_TARGET=60

# Release gate: sustain at least half of N-1 capacity in every region for 30 minutes.
RELEASE_SUSTAINED_SECONDS=1800
RELEASE_LOAD_PERCENT=50
JOIN_SUCCESS_SLO_PERCENT=99.5
JOIN_P95_SLO_MS=5000
HEALTHY_MEDIA_SLO_PERCENT=99.9
PACKET_LOSS_P95_SLO_PERCENT=5
JITTER_P95_SLO_MS=100
RTT_P95_SLO_MS=400
RECORDING_SUCCESS_SLO_PERCENT=99
RECORDING_READY_P95_SLO_MS=300000
FAILURE_RECOVERY_SLO_SECONDS=30
