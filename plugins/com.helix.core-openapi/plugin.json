{
  "id": "com.helix.core-openapi",
  "name": "Helix OpenAPI",
  "version": "1.0.0",
  "description": "Projects registered routes and tools into the Helix OpenAPI 3.1 document.",
  "vendor": { "name": "Helix" },
  "license": "Apache-2.0",
  "sdkVersion": "^1.0.0",
  "kind": "in-process",
  "main": "index.js",
  "capabilities": {
    "provides": ["openapi.document", "rest-endpoints:/openapi.json"],
    "consumes": ["tools.registry", "http.routes"]
  },
  "permissions": {
    "scopes": ["platform.read"],
    "outbound-network": [],
    "filesystem": [],
    "envVars": []
  }
}
