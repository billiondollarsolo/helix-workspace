# Non-secret inputs for docker-compose.production.yml.
# Copy to a protected operator-only env file. Secret values belong in the
# mounted files documented in docs/deployment-production.md, not here.

HELIX_DOMAIN=workspace.example.com
HELIX_SMTP_RECEIVE_PORT=25

# Exact promoted registry references. Replace every placeholder with the
# corresponding main-branch image digest produced by the reviewed CI run.
# Tags alone are intentionally rejected by the release process.
HELIX_IMAGE=ghcr.io/billiondollarsolo/helix-workspace@sha256:REPLACE_WITH_64_HEX
HELIX_WEB_IMAGE=ghcr.io/billiondollarsolo/helix-workspace-web@sha256:REPLACE_WITH_64_HEX
HELIX_POSTGRES_IMAGE=ghcr.io/billiondollarsolo/helix-workspace-postgres@sha256:REPLACE_WITH_64_HEX
HELIX_NATS_IMAGE=ghcr.io/billiondollarsolo/helix-workspace-nats@sha256:REPLACE_WITH_64_HEX
HELIX_MEILISEARCH_IMAGE=ghcr.io/billiondollarsolo/helix-workspace-meilisearch@sha256:REPLACE_WITH_64_HEX
HELIX_CERBOS_IMAGE=ghcr.io/billiondollarsolo/helix-workspace-cerbos@sha256:REPLACE_WITH_64_HEX
HELIX_SPAMD_IMAGE=ghcr.io/billiondollarsolo/helix-workspace-spamassassin@sha256:REPLACE_WITH_64_HEX

# The trusted upstream authenticator must sign the actor-bound MFA assertion
# described in docs/deployment-production.md with the mounted secret.
HELIX_MFA_ASSERTION_ISSUER=https://auth.example.com
HELIX_MFA_ASSERTION_AUDIENCE=helix-workspace

# Approved values: ses, postmark, mailgun, managed-smtp, smtp-relay.
MAIL_PROVIDER=postmark
MAIL_FROM_DOMAIN=example.com
MAIL_SMTP_HOST=smtp.postmarkapp.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=provider-user-id
MAIL_SMTP_SECURE=false

# Set these to true only after collecting the evidence described in the
# production deployment guide. They are attestations, not feature toggles.
HELIX_POSTGRES_ENCRYPTION_AT_REST_ATTESTED=true
HELIX_OBJECT_STORAGE_ENCRYPTION_AT_REST_ATTESTED=true
HELIX_BACKUP_ENCRYPTION_AT_REST_ATTESTED=true
RUSTFS_SERVER_SIDE_ENCRYPTION=AES256

# Backup/restore operators must inject HELIX_BACKUP_MANIFEST_HMAC_KEY from a
# separate protected secret store. Only its non-secret reference belongs here.
HELIX_BACKUP_MANIFEST_HMAC_KEY_REF=vault://production/helix-backup-manifest-hmac

# Explicit Drive scan ceiling for the pilot's supported 1 GiB upload size.
DRIVE_CLAMAV_MAX_BYTES=1073741824
DRIVE_CLAMAV_SCANNER_VERSION=clamd
