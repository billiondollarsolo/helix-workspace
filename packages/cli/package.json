    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@helix/config": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
