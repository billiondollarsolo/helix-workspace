{
  "name": "@helix/cli",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "bin": {
    "helix": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
