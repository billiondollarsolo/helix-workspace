#!/usr/bin/with-contenv sh
# shellcheck shell=sh
set -eu

# The production Meet install mounts each credential as a file named after the
# environment variable the stock image reads. s6 imports every file in its
# container environment directory, so a credential never appears in Compose,
# the image command, or the repository.
for file in /run/helix-jitsi-env/*; do
  [ -f "$file" ] || continue
  value=$(cat "$file")
  [ "${#value}" -ge 32 ] || {
    echo "$(basename "$file") must contain at least 32 characters" >&2
    exit 1
  }
  printf '%s' "$value" > "/var/run/s6/container_environment/$(basename "$file")"
done

# Bind-mounted secrets stay root-owned; Prosody must read its own private copy.
if [ -f /run/secrets/jitsi_xmpp_cert ] && [ -f /run/secrets/jitsi_xmpp_key ]; then
  mkdir -p /config/certs
  for domain in "${XMPP_DOMAIN:-meet.jitsi}" "${XMPP_AUTH_DOMAIN:-auth.meet.jitsi}" \
    "${XMPP_MUC_DOMAIN:-muc.meet.jitsi}" "${XMPP_INTERNAL_MUC_DOMAIN:-internal-muc.meet.jitsi}"; do
    cp /run/secrets/jitsi_xmpp_cert "/config/certs/$domain.crt"
    cp /run/secrets/jitsi_xmpp_key "/config/certs/$domain.key"
    chown prosody:prosody "/config/certs/$domain.crt" "/config/certs/$domain.key"
    chmod 644 "/config/certs/$domain.crt"
    chmod 600 "/config/certs/$domain.key"
  done
fi
