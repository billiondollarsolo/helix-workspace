{
	# Off unless the deployment shares an admin socket with Helix, which uses
	# it only to make Caddy load its certificate folder again. A Unix socket
	# only: never give this a network address.
	admin {$HELIX_CADDY_ADMIN:off}
	servers {
		protocols h1 h2 h3
	}
}

# Container health probe. The site below redirects plain HTTP to HTTPS, so the
# probe needs its own unpublished plain-HTTP listener.
:8081 {
	respond /healthz "ok" 200
	respond 404
}

{$HELIX_DOMAIN} {
	# Certificate source. Empty: automatic HTTPS (Let's Encrypt, ZeroSSL).
	# "<cert> <key>": operator-provided PEM files. "internal": Caddy's local CA,
	# for tests only. See docs/deployment-production.md.
	tls {$HELIX_CADDY_TLS:} {
		protocols tls1.2 tls1.3
		# A certificate uploaded in Admin → Domains is written here by Helix.
		# While one is present Caddy serves it and stops obtaining its own.
		load {$HELIX_EDGE_CERT_DIR:/run/helix-edge-certs}
	}

	# Preserve DAV ETags for conditional edits and S3 object lengths/checksums.
	@compressible not path /dav/* /v1/dav/* /v1/s3 /v1/s3/* /{$HELIX_STORAGE_BUCKET:helix-objects}/*
	encode @compressible zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), fullscreen=(self), geolocation=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-hHzFTfzWwCmwgbHAc/JciBfagnNs4KtGdDWPaK7lCgU='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' wss:; worker-src 'self' blob:; frame-src 'self'"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Cross-Origin-Resource-Policy "same-origin"
		Origin-Agent-Cluster "?1"
		-Server
	}

	# Presigned Drive and Mail object URLs. Browsers cannot reach the bundled
	# object store, so its bucket path is served here. Every request must carry
	# a valid S3 signature; the Host header is passed through because it is
	# part of that signature.
	@objects path /{$HELIX_STORAGE_BUCKET:helix-objects}/*
	handle @objects {
		reverse_proxy {$HELIX_STORAGE_UPSTREAM:https://rustfs:9000} {
			# Caddy rewrites Host to the upstream for HTTPS backends; the
			# signature covers the public host, so keep it.
			header_up Host {host}
			header_up -X-Helix-Mfa-Verified
			transport http {
				tls_server_name rustfs
				tls_trust_pool file {$HELIX_STORAGE_CA_FILE:/run/secrets/rustfs_ca}
			}
		}
	}

	@health path /healthz /readyz
	handle @health {
		reverse_proxy {$HELIX_UPSTREAM} {
			header_up -X-Helix-Mfa-Verified
		}
	}

	@federationRecovery path /v1/federation-operations/*
	handle @federationRecovery {
		reverse_proxy {$HELIX_BACKUP_WORKER_UPSTREAM:backup-worker:3081} {
			header_up -X-Helix-Mfa-Verified
		}
	}

	@backend {
		path /api/* /oauth /oauth/* /trpc /trpc/* /mcp /mcp/* /v1 /v1/*
		path /openapi.json /openapi.yaml /asyncapi.json
		path /events /events/* /ws /ws/* /sync /sync/* /dav /dav/* /.well-known/*
	}
	handle @backend {
		reverse_proxy {$HELIX_UPSTREAM} {
			header_up -X-Helix-Mfa-Verified
		}
	}

	# Meet's LiveKit signalling at /rtc when Meet is installed; otherwise an
	# empty file is imported.
	import optional/meet{$HELIX_MEET_SITE:}.caddy

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# The optional password manager brings its own site. The file name ends in
# "-on" only when the deployment sets the matching variable; otherwise an empty
# file is imported and nothing is served.
import optional/passwords{$HELIX_PASSWORDS_SITE:}.caddy
