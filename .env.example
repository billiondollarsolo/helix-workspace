# Helix local infrastructure defaults.
# Copy to .env for local overrides. Do not use these secrets in production.

POSTGRES_DB=helix
POSTGRES_USER=helix
POSTGRES_PASSWORD=helix_dev_password
POSTGRES_PORT=28432

BETTER_AUTH_ENABLED=true
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=helix_local_better_auth_secret_change_me_32_chars
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173
HELIX_LOCAL_DEMO_PASSWORD=helix-local-dev-password

REDIS_PORT=28433

NATS_CLIENT_PORT=28434
NATS_MONITOR_PORT=28435

MEILI_ENV=development
MEILI_MASTER_KEY=helix_dev_meili_master_key
MEILI_PORT=28436

RUSTFS_ACCESS_KEY=helixrustfs
RUSTFS_SECRET_KEY=helix_rustfs_dev_secret
RUSTFS_BUCKET=helix-objects
RUSTFS_SERVER_DOMAINS=localhost,rustfs
RUSTFS_API_PORT=28437
RUSTFS_CONSOLE_PORT=28438

CERBOS_HTTP_PORT=28439
CERBOS_GRPC_PORT=28440

HELIX_DOMAIN=localhost
HELIX_UPSTREAM=host.docker.internal:3000
CADDY_HTTP_PORT=28441
CADDY_HTTPS_PORT=28442
CADDY_ADMIN_PORT=28443

MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false
MAIL_SMTP_RECEIVER_ENABLED=true
MAIL_SMTP_RECEIVER_HOST=0.0.0.0
MAIL_SMTP_RECEIVER_PORT=2525
HELIX_SMTP_RECEIVE_PORT=28456
MAILPIT_SMTP_PORT=28457
MAILPIT_WEB_PORT=28458

AUDIT_IMMUTABLE_S3_ENABLED=false
AUDIT_IMMUTABLE_S3_ENDPOINT=http://rustfs:9000
AUDIT_IMMUTABLE_S3_BUCKET=helix-audit
AUDIT_IMMUTABLE_S3_ACCESS_KEY=helixrustfs
AUDIT_IMMUTABLE_S3_SECRET_KEY=helix_rustfs_dev_secret
AUDIT_IMMUTABLE_S3_REGION=us-east-1
AUDIT_IMMUTABLE_S3_FORCE_PATH_STYLE=true
AUDIT_IMMUTABLE_S3_PREFIX=audit/activity
AUDIT_IMMUTABLE_S3_BATCH_SIZE=500
AUDIT_IMMUTABLE_S3_INTERVAL_MS=60000
AUDIT_IMMUTABLE_S3_RETENTION_DAYS=365
AUDIT_IMMUTABLE_S3_OBJECT_LOCK_MODE=COMPLIANCE

OLLAMA_BASE_URL=http://localhost:11434/v1
