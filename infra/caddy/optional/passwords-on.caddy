# Optional password manager (Vaultwarden), on its own hostname so the vault
# never shares a browser origin with the workspace.
{$HELIX_PASSWORDS_DOMAIN} {
	tls {$HELIX_CADDY_TLS:} {
		protocols tls1.2 tls1.3
		load {$HELIX_EDGE_CERT_DIR:/run/helix-edge-certs}
	}

	encode zstd gzip

	# The vault sends its own Content-Security-Policy and framing rules; the
	# workspace's would break its web app.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy {$HELIX_PASSWORDS_UPSTREAM:vaultwarden:8080} {
		header_up -X-Helix-Mfa-Verified
	}
}
