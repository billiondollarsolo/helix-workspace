{
  "id": "com.helix.webhook-in-github",
  "name": "GitHub Inbound Webhooks",
  "version": "1.0.0",
  "description": "GitHub signature verification and event payload parsing for inbound webhooks.",
  "vendor": {
    "name": "Helix"
  },
  "license": "Apache-2.0",
  "sdkVersion": "^1.0.0",
  "kind": "in-process",
  "category": "connector",
  "main": "index.js",
  "capabilities": {
    "provides": [
      "webhook.in.source.github"
    ],
    "consumes": [
      "webhook.engine",
      "events"
    ]
  },
  "permissions": {
    "scopes": [
      "webhooks.write"
    ],
    "outbound-network": [],
    "filesystem": [],
    "envVars": []
  }
}
