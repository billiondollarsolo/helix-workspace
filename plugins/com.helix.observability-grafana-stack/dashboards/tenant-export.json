{
  "uid": "helix-tenant-export",
  "title": "Helix Tenant Export",
  "tags": ["helix", "tenant-export"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Export job outcomes",
      "datasource": { "type": "prometheus", "uid": "helix-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(helix_tenant_export_jobs_total[5m])) by (status, object_bytes)"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active export jobs",
      "datasource": { "type": "prometheus", "uid": "helix-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(helix_tenant_export_jobs_active) by (status)"
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Stalled export jobs",
      "datasource": { "type": "prometheus", "uid": "helix-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "helix_tenant_export_stalled_jobs"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Oldest stalled export age",
      "datasource": { "type": "prometheus", "uid": "helix-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "helix_tenant_export_oldest_stalled_age_seconds"
        }
      ],
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
    }
  ]
}
